# Environment Variables Example

NODE_ENV=development
PORT=3001
HOST=0.0.0.0
DATABASE_URL=postgresql://user:password@localhost:5432/almox
SESSION_SECRET=change-me-minimum-32-characters
SESSION_TTL_HOURS=8
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOG_LEVEL=info
SEED_ENABLED=false

# Producao:
# NODE_ENV=production
# PORT=<fornecido pelo provedor>
# HOST=0.0.0.0
# DATABASE_URL=<secret PostgreSQL gerenciado>
# SESSION_SECRET=<secret forte gerado fora do repositorio>
# CORS_ORIGIN=https://seu-dominio.example
# SEED_ENABLED=false
